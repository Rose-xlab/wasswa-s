# ── Pocket Option ─────────────────────────────────────────────
# The URL you normally log in at. Adjust if your region differs.
PO_BASE_URL=https://pocketoption.com/en/login
# Where the trading terminal lives after login (used by the spike).
PO_CABINET_URL=https://pocketoption.com/en/cabinet

# ── Phase 1 spike ─────────────────────────────────────────────
# Headed vs headless for local runs (Phase 1 recommends headed).
HEADLESS=false
# How long the spike records frames before auto-summarizing (ms).
SPIKE_DURATION_MS=180000

# ── Streak detection (Phase 2) ────────────────────────────────
STREAK_THRESHOLD=7
TIMEFRAME_SEC=60
GRACE_SEC=1.5
BREAK_ON_DOJI=true

# ── Telegram alerts (Phase 2 — needed to send alerts) ─────────
# TELEGRAM_BOT_TOKEN=      # from BotFather
# TELEGRAM_CHAT_ID=        # your user/group/channel id

# ── Shadow research log (records setups; places NO trades) ────
SHADOW_ENABLED=true
# Log every streak this long or longer. Deliberately BELOW the alert
# threshold: you cannot tell whether depth helps without the base rates at
# short streaks. Log wide, trade narrow.
SHADOW_COLLECT_STREAK=4
# Option life in seconds — the terminal's "Time" field. Quick High/Low
# defaults to 00:01:00, a ROLLING 60s from the click (not candle-aligned).
SHADOW_EXPIRY_SEC=60
# Click offsets (sec after the entry candle's open) to score. Every setup is
# settled at each, so entry timing can be compared head to head.
SHADOW_ENTRY_OFFSETS=0,2,5,10,15,30
# Give up waiting for settlement ticks this long after the entry candle.
SHADOW_RESOLVE_TIMEOUT_SEC=600
# Per-symbol tick retention. Must exceed one full sweep + expiry.
TICK_RETAIN_SEC=1200

# ── Stage 2: auto-execution (both switches default OFF) ───────
# EXECUTE_ENABLED=true with EXECUTE_DRY_RUN=true is a full rehearsal that
# clicks nothing. Verify selectors with `npm run probe:ui` first.
# Create logs/HALT at any time to stop execution immediately.
EXECUTE_ENABLED=false
EXECUTE_DRY_RUN=true
EXECUTE_DIRECTION=fade     # fade = bet it breaks | ride = bet it continues
EXECUTE_STREAK=8           # fire at streak 8 = enter on candle 9
EXECUTE_ARM_MARGIN=2       # pre-select the chart 2 candles early
EXECUTE_STAKE_PCT=1        # flat % of balance — no martingale exists in code
EXECUTE_MAX_STAKE=1000
EXECUTE_MIN_PAYOUT=90      # break-even at 90% is 52.6%
EXECUTE_MAX_CONCURRENT=1   # one armed chart = one position
EXECUTE_MAX_TRADES_PER_DAY=30
EXECUTE_MAX_CONSEC_LOSSES=3
EXECUTE_DAILY_LOSS_PCT=5
EXECUTE_COOLDOWN_SEC=30
# Demo is enforced from the live page, not a flag. Real money needs
# PV_ALLOW_LIVE=I_UNDERSTAND_REAL_MONEY — deliberately awkward.

# ── (Later phases) ────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # VPS scanner ONLY — never in the browser
